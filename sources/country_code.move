/// `CountryCode` — a validated ISO 3166-1 alpha-2 country code (e.g. "JP").
///
/// A sibling to `language_code`: a tiny value primitive that parses a raw string
/// once, checking it against the officially-assigned alpha-2 set, and thereafter
/// carries a type that is provably a real country code. Consumers store
/// `CountryCode` (or `Option<CountryCode>` / `vector<CountryCode>`) and never
/// re-validate. The set lives in bytecode via a macro — no on-chain state.
module country_code::country_code;

use std::string::String;

// === Structs ===

public struct CountryCode(String) has copy, drop, store;

// === Errors ===

#[error(code = 0)]
const EInvalidCountryCode: vector<u8> = b"Invalid country code.";

// === Public Functions ===

/// Creates a `CountryCode` from a string. Aborts unless `code` is an assigned
/// ISO 3166-1 alpha-2 code (two uppercase letters).
public fun new(code: String): CountryCode {
    assert!(country_codes!().contains(&code), EInvalidCountryCode);
    CountryCode(code)
}

// === Public View Functions ===

/// Returns the underlying code string.
public fun code(country_code: &CountryCode): String {
    country_code.0
}

